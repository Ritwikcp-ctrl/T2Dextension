{
  "manifest_version": 3,
  "name": "Keyboard Distance",
  "version": "1.0.0",
  "description": "Tracks keyboard distance",

  "permissions": [
    "storage"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}