{
  "manifest_version": 3,

  "name": "Keyboard Distance",

  "version": "1.0.0",

  "description": "Turn your typing into measurable distance. 100 typed characters equals 1 meter.",

  "permissions": ["storage"],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Keyboard Distance",
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
